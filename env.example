# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# Твой Telegram ID (для админ-команды /stats)
ADMIN_ID=123456789

# Адрес мини-аппа — публичный HTTPS-домен сервиса на Railway
# (Settings → Networking → Generate Domain). Если не задан, бот сам возьмёт
# RAILWAY_PUBLIC_DOMAIN, который Railway выставляет автоматически.
MINIAPP_URL=https://your-service.up.railway.app/

# Путь к базе SQLite. На Railway — путь внутри Volume, иначе прогресс
# стирается при каждом деплое (Volume с mount path /data):
DB_PATH=/data/lifequest.db

# Порт HTTP-сервера. Railway задаёт его сам — локально можно не трогать.
PORT=8080

# Необязательно: старая карта недели на GitHub Pages (запасной вариант)
# LEGACY_BOARD_URL=https://likamaier.github.io/lifequest-bot/
